# Local API defaults. The API binds to loopback unless ADAPTIVEML_HOST is set.
ADAPTIVEML_HOST=127.0.0.1
ADAPTIVEML_PORT=8765
ADAPTIVEML_MODE=simulation
ADAPTIVEML_DB=data/runtime/adaptiveml.sqlite3
ADAPTIVEML_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADAPTIVEML_ESP32_MIN_SUPPLY_V=3.0
ADAPTIVEML_ESP32_MAX_CURRENT_A=0.9
ADAPTIVEML_FL_MAX_RTT_MS=250
ADAPTIVEML_FL_MAX_PACKET_LOSS_PCT=5
ADAPTIVEML_FL_MAX_BANDWIDTH_UTILIZATION_PCT=90
ADAPTIVEML_FL_MAX_SECURITY_RISK=0.70
ADAPTIVEML_FL_MIN_PREDICTION_CONFIDENCE=0.50

# Networked computer-node FedAvg. Replace every placeholder with a unique random secret.
# Coordinator/admin token authorizes starting a run; each node has its own bearer token.
SARA_FL_COORDINATOR_TOKEN=replace-with-a-long-random-coordinator-secret
SARA_FL_NODE_TOKENS={"node-a":"replace-with-unique-node-a-secret","node-b":"replace-with-unique-node-b-secret"}

# Trusted peer inference is disabled until explicitly configured.
# Use HTTPS endpoints and a unique shared token per trusted deployment.
SARA_TRUSTED_NODES=[]
# SARA_NODE_TOKEN=replace-with-a-long-random-secret

# Optional authorized live packet capture. Never enable without network-owner permission.
ADAPTIVEML_ENABLE_LIVE_CAPTURE=false
ADAPTIVEML_CAPTURE_INTERFACE=
